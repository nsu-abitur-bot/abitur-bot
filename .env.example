# Инфраструктура. Прикладные настройки задаются в админке → Настройки экземпляра.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=abitur
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/abitur
# DATABASE_URL перекрывает DB_*. Пароль в URL должен быть URL-encoded.
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379

# Корневые секреты. Хранить и резервировать отдельно от базы.
# uv run python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-me-to-a-long-random-string
# uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SETTINGS_ENCRYPTION_KEY=

# Параметры размещения, файлов и диагностики процессов.
CORS_ALLOW_ORIGINS=http://localhost:3000
LIGHTRAG_WORKSPACE_BASE=./data/lightrag
LIGHTRAG_STORAGE=json
TELEGRAM_POLLING_LOCK_FILE=/tmp/abitur_telegram_polling.lock
LOG_LEVEL=INFO
LOG_DIR=logs
RAG_LOG_TEXT_PREVIEW_LIMIT=2000
RAG_LOG_CHUNKS_LIMIT=10
LIGHTRAG_CACHE_CLEAR_TIMEOUT=10
TEST_DB_NAME=abitur_test

# Переход существующего экземпляра: docs/instance-settings.md.
# До первого запуска новой версии выполните импорт старого .env командой:
# uv run python -m bootstrap.runtime_settings
# Старый .env при этом сохраняется; затем удалите из него ключи LLM/ботов.
