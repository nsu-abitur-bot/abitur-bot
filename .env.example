# Auth (JWT)
# Сгенерируй: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Telegram
BOT_TOKEN=...
# SOCKS5 прокси для Telegram Bot API (опционально)
# Пример: socks5://user:pass@proxy.host:1080
TELEGRAM_SOCKS5_PROXY=
# Путь lock-файла, чтобы запускался только один Telegram polling процесс
TELEGRAM_POLLING_LOCK_FILE=/tmp/abitur_telegram_polling.lock

# MAX
MAX_BOT_TOKEN=...


# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=abitur

DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Полный URL подключения. Если задан — ПОЛНОСТЬЮ перекрывает все DB_* выше
# (нормализуется postgresql:// → postgresql+asyncpg://). Не задавай его,
# если настраиваешь базу через DB_HOST/DB_PORT/... — правки DB_* действовать
# не будут (частая ошибка).
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/abitur

# Redis
# Пароль обязателен для docker-compose (redis запускается с --requirepass).
# Только буквы/цифры: пароль вставляется в REDIS_URL, спецсимволы (@ : / $ и т.п.) сломают URL
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@localhost:6379

# CORS для API админки: список источников через запятую.
# По умолчанию (если не задано) — "*", то есть любой источник; для прода с
# админкой обязательно сузь до явных доменов фронта
CORS_ALLOW_ORIGINS=*
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://abitur.example.ru

# OpenAI
OPENAI_API_KEY=...
# SOCKS5 прокси для OpenAI API (опционально)
# Пример: socks5://user:pass@proxy.host:1080
OPENAI_SOCKS5_PROXY=
# Модель для ответов бота
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=60
# Модели для LightRAG (построение и поиск по графу)
OPENAI_GRAPH_MODEL=gpt-4o-mini
OPENAI_GRAPH_EMBEDDING_MODEL=text-embedding-3-small
# Модель эмбеддингов для кэша вопросов (не для графа)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Модель Vision для PDF. Дефолт — единственное место: llm/profiles.py,
# VISION_MODEL_DEFAULTS (#326)
OPENAI_MODEL_VISION=gpt-5.4-mini

# Gemini
GEMINI_API_KEY=...
# Модель для ответов бота
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_TEMPERATURE=0.2
# Модели для LightRAG
GEMINI_GRAPH_MODEL=gemini-3.1-flash-lite-preview
GEMINI_GRAPH_EMBEDDING_MODEL=gemini-embedding-2-preview
# Модель Vision для PDF. Дефолт — единственное место: llm/profiles.py,
# VISION_MODEL_DEFAULTS (#326)
GEMINI_MODEL_VISION=gemini-2.5-flash

# Выбор провайдера для ответов бота: openai | gemini
LLM_PROVIDER=gemini

# Выбор провайдера для LightRAG (LLM + эмбеддинги): openai | gemini
LIGHTRAG_LLM_PROVIDER=gemini

# FAQ-матчер
# Порог косинусного сходства для срабатывания (0.5..1). Ниже 0.95 FAQ начинает
# отвечать на соседние вопросы чужим готовым ответом — см. комментарий в
# faq/matcher.py. Значение из админки (PUT /api/v1/settings/faq) перекрывает
# env без рестарта бота.
FAQ_SIMILARITY_THRESHOLD=0.95

# ==========================================
# LightRAG (графовая база знаний)
# ==========================================
# База каталогов рабочих пространств графов
LIGHTRAG_WORKSPACE_BASE=./data/lightrag
# Параллельные LLM-запросы при построении графа (упираются в rate-limit)
LIGHTRAG_LLM_WORKERS=1
# Параллельные запросы эмбеддингов при построении графа
LIGHTRAG_EMBEDDING_WORKERS=2
# Секунды между проверками, не пора ли чистить кэш графов (по диску)
LIGHTRAG_CACHE_CLEAR_TIMEOUT=10
# Хранилище KV/doc_status графов: json (файлы) | postgres (JSONB в БД).
# POSTGRES_WORKSPACE при этом не задавать: он свалит все графы в одно
# рабочее пространство (см. rag/pg_storage.py)
LIGHTRAG_STORAGE=json

# Логирование RAG-поиска: сколько чанков и сколько символов текста чанка
# писать в лог ответа
RAG_LOG_CHUNKS_LIMIT=10
RAG_LOG_TEXT_PREVIEW_LIMIT=2000

# ==========================================
# CRAG (корректирующий RAG)
# ==========================================
# Рабочие значения читаются из БД и меняются через веб-админку
# (PUT /api/v1/settings/crag) БЕЗ рестарта; эти env — дефолт, когда в БД
# ключа нет (см. rag/crag.py: load_crag_config).
CRAG_ENABLED=true
# Порог LLM-оценки релевантности чанка (0..1), ниже — отсекаем
CRAG_RELEVANCE_THRESHOLD=0.5
# Минимум чанков после фильтра, ниже — пробуем доретрив
CRAG_MIN_CHUNKS=2
# Разрешить одну переформулировку запроса и доретрив
CRAG_ALLOW_REFINE=true
# Авторитетная фильтрация по таблице факультетов
CRAG_USE_FACULTY_TABLE=true
# Максимум чанков на LLM-грейдинг (контроль латентности)
CRAG_MAX_GRADED_CHUNKS=12
# Сколько чанков грейдить параллельно (упирается в rate-limit провайдера)
CRAG_GRADING_CONCURRENCY=5

# ==========================================
# Конкурсные списки (scheduler)
# ==========================================
# Степень: bachelor | master
RATING_DEGREE=bachelor
# Типы отслеживаемых списков через запятую. 30 — «если бы зачисление
# состоялось сегодня»; 0 — подавшие, 20 — рейтинговый, 50 — высший приоритет
RATING_TYPES=30
# Опрос сайта НГУ: секунды между проверками (min/max) и стартовая пауза
RATING_POLL_MIN_SECONDS=300
RATING_POLL_MAX_SECONDS=1800
RATING_POLL_START_SECONDS=1800
# Пауза между запросами списков внутри одной сессии, сек
RATING_REQUEST_DELAY=0.3
# Доля упавших списков, при которой сессия считается неудачной (0..1)
RATING_FAILED_LISTS_THRESHOLD=0.2
# Сколько раз обновлять CSRF-сессию, прежде чем сдаться
RATING_MAX_SESSION_REFRESHES=3
# Мок-режим: 1 — брать список с MOCK_RATING_URL вместо сайта НГУ (для отладки)
RATING_USE_MOCK=
MOCK_RATING_URL=http://host.docker.internal:3000/api/rating

# Пауза между отправкой уведомлений абонентам Telegram, сек (антифлуд)
NOTIFY_SEND_DELAY=0.035

# ==========================================
# Справочники при старте (bootstrap)
# ==========================================
# 1 — жёстко перезалить справочник факультетов, затирая правки из админки;
# по умолчанию мягкая доливка только недостающего
SEED_FACULTIES_FORCE=0
# Автозаливка проходных баллов прошлых лет со страницы итогов приёма НГУ
SEED_ADMISSION_SCORES=1
# 1 — залить, даже если заливали недавно (игнорировать свежесть)
SEED_ADMISSION_SCORES_FORCE=0
# Страница итогов приёма (откуда брать баллы)
ADMISSION_SCORES_URL=https://www.nsu.ru/n/education/apply-info/itogi-priema/
# Сколько часов свежести заливки достаточно, чтобы не дёргать сайт на рестарте
ADMISSION_SCORES_MAX_AGE_HOURS=24

# ==========================================
# PDF Parser (Vision LLM)
# ==========================================
# Провайдер парсинга PDF (gemini / openai). Дефолт и здесь, и в коде — gemini
PDF_PARSER_PROVIDER=gemini

# Testing
TEST_DB_NAME=abitur_test

# Logging
# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Директория для логов (по умолчанию: logs)
LOG_DIR=logs
