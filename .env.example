# Telegram
BOT_TOKEN=...
# SOCKS5 прокси для Telegram Bot API (опционально)
# Пример: socks5://user:pass@proxy.host:1080
TELEGRAM_SOCKS5_PROXY=
# Путь lock-файла, чтобы запускался только один Telegram polling процесс
TELEGRAM_POLLING_LOCK_FILE=/tmp/abitur_telegram_polling.lock

# MAX
MAX_BOT_TOKEN=...


# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=abitur

DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10


# Redis
REDIS_URL = "redis://localhost:6379"

# OpenAI
OPENAI_API_KEY=...
# SOCKS5 прокси для OpenAI API (опционально)
# Пример: socks5://user:pass@proxy.host:1080
OPENAI_SOCKS5_PROXY=
# Модель для ответов бота
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SECONDS=60
# Модели для LightRAG (построение и поиск по графу)
OPENAI_GRAPH_MODEL=gpt-4o-mini
OPENAI_GRAPH_EMBEDDING_MODEL=text-embedding-3-small
# Модель Vision для PDF
OPENAI_MODEL_VISION=gpt-4o-mini

# Gemini
GEMINI_API_KEY=...
# Модель для ответов бота
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
GEMINI_TEMPERATURE=0.2
# Модели для LightRAG
GEMINI_GRAPH_MODEL=gemini-3.1-flash-lite-preview
GEMINI_GRAPH_EMBEDDING_MODEL=gemini-embedding-2-preview
# Модель Vision для PDF
GEMINI_MODEL_VISION=gemini-3.1-flash-lite-preview

# Выбор провайдера для ответов бота: openai | gemini
LLM_PROVIDER=gemini

# Выбор провайдера для LightRAG (LLM + эмбеддинги): openai | gemini
LIGHTRAG_LLM_PROVIDER=gemini

# ==========================================
# PDF Parser (Vision LLM)
# ==========================================
# Провайдер парсинга PDF (gemini / openai)
PDF_PARSER_PROVIDER=gemini

# Testing
TEST_DB_NAME=abitur_test

# Logging
# Уровень логирования: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Директория для логов (по умолчанию: logs)
LOG_DIR=logs
